{
  "description": "tasklog log enrichment: geo from client_ip, dataset tagging",
  "processors": [
    {
      "geoip": {
        "field": "client_ip",
        "target_field": "client.geo",
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "event.dataset",
        "value": "tasklog.api",
        "ignore_failure": true
      }
    },
    {
      "convert": {
        "field": "status",
        "type": "integer",
        "ignore_missing": true,
        "ignore_failure": true
      }
    }
  ]
}
