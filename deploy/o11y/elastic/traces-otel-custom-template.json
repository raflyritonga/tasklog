{
  "template": {
    "settings": {
      "index.default_pipeline": "tasklog-otel-apm-compat"
    },
    "mappings": {
      "properties": {
        "processor": { "properties": { "event": { "type": "keyword" } } },
        "agent": { "properties": { "name": { "type": "keyword" } } },
        "event": { "properties": { "outcome": { "type": "keyword" } } },
        "timestamp": { "properties": { "us": { "type": "long" } } },
        "transaction": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" },
            "type": { "type": "keyword" },
            "result": { "type": "keyword" },
            "sampled": { "type": "boolean" },
            "representative_count": { "type": "double" },
            "duration": { "properties": { "us": { "type": "long" } } }
          }
        },
        "span": {
          "properties": {
            "type": { "type": "keyword" },
            "subtype": { "type": "keyword" },
            "representative_count": { "type": "double" },
            "duration": { "properties": { "us": { "type": "long" } } }
          }
        }
      }
    }
  }
}
