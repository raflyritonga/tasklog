{
  "version": 16,
  "variables": [],
  "tiles": {
    "0": {
      "type": "data",
      "title": "Request rate by endpoint",
      "query": "fetch spans\n| filter span.kind == \"server\" and service.name == \"tasklog-api\"\n| makeTimeseries requests = count(), by:{span.name}, interval:1m",
      "visualization": "lineChart",
      "davis": {
        "enabled": false
      },
      "visualizationSettings": {
        "chartSettings": {
          "gapPolicy": "connect"
        },
        "thresholds": [],
        "singleValue": {
          "showLabel": true
        },
        "table": {
          "enableSparklines": false
        }
      }
    },
    "1": {
      "type": "data",
      "title": "Error ratio (%)",
      "query": "fetch spans\n| filter span.kind == \"server\" and service.name == \"tasklog-api\"\n| makeTimeseries error_pct = countIf(request.is_failed == true) * 100.0 / count(), interval:1m",
      "visualization": "lineChart",
      "davis": {
        "enabled": false
      },
      "visualizationSettings": {
        "chartSettings": {
          "gapPolicy": "connect"
        },
        "thresholds": [],
