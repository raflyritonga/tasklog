{
  "uid": "tasklog-golden",
  "title": "Tasklog golden signals",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "deploys",
        "datasource": {
          "type": "datasource",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "type": "tags",
        "tags": [
          "deploy"
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Golden signals",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_server_request_count_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx error ratio (current)",
      "gridPos": {
        "h": 8,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "100 * (sum(rate(http_server_request_count_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_request_count_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error ratio",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_request_count_total{status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_request_count_total[1m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{route!=\"\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{route!=\"\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Latency distribution heatmap",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "options": {
        "yAxis": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(http_server_request_duration_seconds_bucket{route!=\"\"}[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "What changed",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Service version",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "options": {
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "group by (service_version) (http_server_request_count_total{service_name=\"tasklog-api\"})",
          "legendFormat": "{{service_version}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate with deploy annotations",
      "gridPos": {
        "h": 6,
        "w": 20,
        "x": 4,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_count_total[1m]))",
          "legendFormat": "total request rate"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Dependencies",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis cache hit ratio",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis throughput and memory",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "ops/s"
        },
        {
          "refId": "B",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "memory used"
        }
      ]
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Postgres connection utilization",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "100 * sum(pg_stat_activity_count{datname=\"tasklog\"}) / max(pg_settings_max_connections)"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Top queries by mean execution time",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "datasource": {
        "type": "postgres",
        "uid": "pg"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select left(query, 80) as query, calls, round(mean_exec_time::numeric, 2) as mean_ms, round(total_exec_time::numeric, 0) as total_ms from pg_stat_statements s join pg_database d on d.oid = s.dbid where d.datname = 'tasklog' and query not ilike '%pg_stat_statements%' order by mean_exec_time desc limit 5"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Runtime + infra (USE)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutine_count",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Go runtime memory",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (go_memory_type) (go_memory_used_bytes)",
          "legendFormat": "{{go_memory_type}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "CPU throttling ratio (live after phase 8)",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 12,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"tasklog\"}[5m])) / sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"tasklog\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Pod memory usage vs limits (live after phase 8)",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 16,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"tasklog\", container!=\"\"})",
          "legendFormat": "{{pod}} used"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"tasklog\", resource=\"memory\"})",
          "legendFormat": "{{pod}} limit"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Pod restarts over 1h (live after phase 8)",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 20,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"tasklog\"}[1h]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service=~\".+\"}[1m]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Error log rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({level=\"error\"}[1m]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 105,
      "type": "row",
      "title": "Pipeline",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Collector spans sent vs failed",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_sent_spans[5m]))",
          "legendFormat": "sent"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_send_failed_spans[5m])) or vector(0)",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Collector metric points sent vs failed",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_sent_metric_points[5m]))",
          "legendFormat": "sent"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points[5m])) or vector(0)",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Vector events shipped by sink",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component_id) (rate(vector_component_sent_events_total{component_kind=\"sink\"}[5m]))",
          "legendFormat": "{{component_id}}"
        }
      ]
    }
  ]
}
