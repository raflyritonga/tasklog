{
  "uid": "tasklog-app",
  "title": "Tasklog \u00b7 Application",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Golden signals",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_server_request_count_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx error ratio (current)",
      "gridPos": {
        "h": 8,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "100 * (sum(rate(http_server_request_count_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_request_count_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error ratio",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_request_count_total{status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_request_count_total[1m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{route!=\"\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{route!=\"\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Latency distribution heatmap",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "options": {
        "yAxis": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(http_server_request_duration_seconds_bucket{route!=\"\"}[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "What changed",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Service version",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "options": {
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "group by (service_version) (http_server_request_count_total{service_name=\"tasklog-api\"})",
          "legendFormat": "{{service_version}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate with deploy annotations",
      "gridPos": {
        "h": 6,
        "w": 20,
        "x": 4,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_count_total[1m]))",
          "legendFormat": "total request rate"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service=~\".+\"}[1m]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Error log rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({level=\"error\"}[1m]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Runtime",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutine_count",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Go runtime memory",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (go_memory_type) (go_memory_used_bytes)",
          "legendFormat": "{{go_memory_type}}"
        }
      ]
    },
    {
      "id": 106,
      "type": "row",
      "title": "Cross-source (Elasticsearch)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      }
    },
    {
      "id": 50,
      "type": "timeseries",
      "title": "Log volume from Elasticsearch (cross-source)",
      "description": "Same dashboard, different database: this panel queries self-hosted Elasticsearch while its neighbours query Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "elastic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "service.name:tasklog-api",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "@timestamp",
          "alias": "log lines"
        }
      ]
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Error logs by country from Elasticsearch (geo-enriched)",
      "description": "client_ip enriched by an Elasticsearch ingest pipeline; Prometheus cannot answer this question",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "elastic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "log.level:error",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "client.geo.country_iso_code",
              "settings": {
                "size": "5",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "deploys",
        "datasource": {
          "type": "datasource",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "type": "tags",
        "tags": [
          "deploy"
        ]
      }
    ]
  }
}
