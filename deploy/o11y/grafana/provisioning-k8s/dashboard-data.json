{
  "uid": "tasklog-data",
  "title": "Tasklog \u00b7 Data stores",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Redis",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis cache hit ratio",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis throughput and memory",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "ops/s"
        },
        {
          "refId": "B",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "memory used"
        }
      ]
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Redis keyspace hits vs misses",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_keyspace_hits_total[5m])",
          "legendFormat": "hits"
        },
        {
          "refId": "B",
          "expr": "rate(redis_keyspace_misses_total[5m])",
          "legendFormat": "misses"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Postgres",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Postgres connection utilization",
      "gridPos": {
        "h": 9,
        "w": 4,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "100 * sum(pg_stat_activity_count{datname=\"tasklog\"}) / max(pg_settings_max_connections)"
        }
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Postgres transactions per second",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 4,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"tasklog\"}[5m]))",
          "legendFormat": "commits"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"tasklog\"}[5m]))",
          "legendFormat": "rollbacks"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Top queries by mean execution time",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "pg"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select left(query, 80) as query, calls, round(mean_exec_time::numeric, 2) as mean_ms, round(total_exec_time::numeric, 0) as total_ms from pg_stat_statements s join pg_database d on d.oid = s.dbid where d.datname = 'tasklog' and query not ilike '%pg_stat_statements%' order by mean_exec_time desc limit 5"
        }
      ]
    }
  ]
}
